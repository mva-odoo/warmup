<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_warmup_sequence_list" model="ir.ui.view">
        <field name="name">warmup.sequence.list</field>
        <field name="model">warmup.sequence</field>
        <field name="arch" type="xml">
            <list string="Séquences">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="world"/>
                <field name="step_count"/>
                <field name="est_duration"/>
                <field name="session_count"/>
            </list>
        </field>
    </record>

    <record id="view_warmup_sequence_form" model="ir.ui.view">
        <field name="name">warmup.sequence.form</field>
        <field name="model">warmup.sequence</field>
        <field name="arch" type="xml">
            <form string="Séquence d'échauffement">
                <header>
                    <button name="action_play" type="object" string="▶ Jouer" class="btn-primary"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archivée" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="ex. Le match du mercredi"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="world"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="step_count"/>
                            <field name="est_duration"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Notes (optionnel)…"/>
                    <notebook>
                        <page string="Étapes" name="steps">
                            <field name="step_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="move"/>
                                    <field name="count" invisible="move not in ('jump', 'squat', 'smash', 'bubbles', 'moles', 'slice', 'cubes', 'foam', 'goal', 'kick', 'act_shelf', 'act_clap', 'act_swim', 'act_launch', 'act_stomp', 'arena_mur', 'arena_pimprenelle', 'arena_neige')"/>
                                    <field name="duration" invisible="move not in ('run', 'shop', 'rest', 'bubbles', 'freeze', 'catch', 'tunnel', 'moles', 'slice', 'foam')"/>
                                    <field name="pose" invisible="move != 'pose'"/>
                                    <field name="hold" invisible="move not in ('pose', 'dance', 'cubes')"/>
                                    <field name="combo" invisible="move != 'dance'" placeholder="armsUp,squat,left,right,jump,star"/>
                                    <field name="text" invisible="move != 'rest'"/>
                                    <field name="summary" optional="hide"/>
                                </list>
                            </field>
                            <div class="text-muted small">
                                Danse (enchaînement) : gestes séparés par des virgules parmi
                                <code>armsUp</code>, <code>airplane</code>, <code>star</code>, <code>flamingo</code>, <code>squat</code>,
                                <code>left</code>, <code>right</code>, <code>jump</code>, <code>smash</code>.
                                Pendant une « Pose à tenir », une créature peut apparaître : l'enfant la rend amie en tenant la pose.
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_warmup_sequence_search" model="ir.ui.view">
        <field name="name">warmup.sequence.search</field>
        <field name="model">warmup.sequence</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="mondes" string="Mondes" domain="[('world', 'in', ['stade', 'supermarche', 'singes', 'chateau', 'banquise', 'dinos', 'espace', 'disco'])]"/>
                <filter name="anciens" string="Anciens mondes" domain="[('world', 'not in', ['stade', 'supermarche', 'singes', 'chateau', 'banquise', 'dinos', 'espace', 'disco'])]"/>
                <separator/>
                <filter name="archived" string="Archivées" domain="[('active', '=', False)]"/>
                <filter name="group_world" string="Monde" context="{'group_by': 'world'}"/>
            </search>
        </field>
    </record>

    <record id="action_warmup_sequence" model="ir.actions.act_window">
        <field name="name">Séquences d'échauffement</field>
        <field name="res_model">warmup.sequence</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_world': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Crée une séquence d'échauffement</p>
            <p>La première séquence de chaque monde est jouée par défaut ; s'il y en a plusieurs, le jeu propose de choisir.</p>
        </field>
    </record>
</odoo>
