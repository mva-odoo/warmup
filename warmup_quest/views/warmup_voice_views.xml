<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_warmup_voice_list" model="ir.ui.view">
        <field name="name">warmup.voice.list</field>
        <field name="model">warmup.voice</field>
        <field name="arch" type="xml">
            <list string="Voix enregistrées" create="false">
                <field name="text"/>
                <field name="moment" optional="show"/>
                <field name="player_id" optional="show"/>
                <field name="write_date" string="Enregistrée le"/>
            </list>
        </field>
    </record>

    <record id="view_warmup_voice_form" model="ir.ui.view">
        <field name="name">warmup.voice.form</field>
        <field name="model">warmup.voice</field>
        <field name="arch" type="xml">
            <form string="Voix enregistrée" create="false">
                <sheet>
                    <group>
                        <field name="text"/>
                        <field name="moment"/>
                        <field name="player_id" invisible="not moment"/>
                        <field name="audio" filename="text"/>
                        <field name="key" groups="base.group_no_one"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_warmup_voice" model="ir.actions.act_window">
        <field name="name">Voix et messages perso</field>
        <field name="res_model">warmup.voice</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Pas encore de voix enregistrée</p>
            <p>Dans le jeu : ⚙️ Réglages (parents) › 🎙️ Studio voix. Enregistre ta voix pour remplacer celle du jeu.</p>
        </field>
    </record>
</odoo>
