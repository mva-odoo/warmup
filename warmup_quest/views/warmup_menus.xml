<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_warmup_play" model="ir.actions.act_url">
        <field name="name">Jouer à Warm-Up Quest</field>
        <field name="url">/warmup</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_warmup_root" name="Warm-Up Quest"
              web_icon="warmup_quest,static/description/icon.png" sequence="90"/>

    <menuitem id="menu_warmup_play" name="▶ Jouer" parent="menu_warmup_root"
              action="action_warmup_play" sequence="1"/>
    <menuitem id="menu_warmup_session" name="Parties" parent="menu_warmup_root"
              action="action_warmup_session" sequence="10"/>
    <menuitem id="menu_warmup_player" name="Joueurs" parent="menu_warmup_root"
              action="action_warmup_player" sequence="20"/>
    <menuitem id="menu_warmup_catch" name="Carnets" parent="menu_warmup_root"
              action="action_warmup_catch" sequence="30"/>

    <menuitem id="menu_warmup_config" name="Configuration" parent="menu_warmup_root" sequence="90"/>
    <menuitem id="menu_warmup_sequence" name="Séquences d'échauffement" parent="menu_warmup_config"
              action="action_warmup_sequence" sequence="10"/>
    <menuitem id="menu_warmup_creature" name="Créatures" parent="menu_warmup_config"
              action="action_warmup_creature" sequence="20"/>
</odoo>
