<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_warmup_player_list" model="ir.ui.view">
        <field name="name">warmup.player.list</field>
        <field name="model">warmup.player</field>
        <field name="arch" type="xml">
            <list string="Joueurs">
                <field name="image_128" widget="image" options="{'size': [32, 32]}" string=""/>
                <field name="name"/>
                <field name="session_count"/>
                <field name="best_score"/>
                <field name="total_minutes"/>
                <field name="creature_count"/>
                <field name="evolved_count" optional="hide"/>
                <field name="color" widget="color" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_warmup_player_form" model="ir.ui.view">
        <field name="name">warmup.player.form</field>
        <field name="model">warmup.player</field>
        <field name="arch" type="xml">
            <form string="Joueur">
                <header>
                    <button name="action_play" type="object" string="▶ Jouer" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_sessions" type="object" class="oe_stat_button" icon="fa-trophy">
                            <field name="session_count" widget="statinfo" string="Parties"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archivé" bg_color="text-bg-danger" invisible="active"/>
                    <field name="image_128" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Prénom de l'enfant"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="color" widget="color"/>
                            <field name="birth_year"/>
                            <field name="user_id"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="best_score"/>
                            <field name="total_minutes"/>
                            <field name="creature_count"/>
                            <field name="evolved_count"/>
                            <field name="sticker_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Parties" name="sessions">
                            <field name="session_ids" readonly="1">
                                <list>
                                    <field name="date"/>
                                    <field name="world"/>
                                    <field name="score"/>
                                    <field name="stars"/>
                                    <field name="score_percent" widget="progressbar"/>
                                    <field name="duration_min"/>
                                    <field name="mode" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page string="Gommettes" name="stickers">
                            <field name="sticker_display" readonly="1" nolabel="1" class="fs-1"
                                   placeholder="Pas encore de gommette : elles se gagnent à la fin de chaque partie !"/>
                        </page>
                        <page string="Carnet des créatures" name="carnet">
                            <field name="catch_ids">
                                <list editable="bottom">
                                    <field name="creature_id"/>
                                    <field name="element"/>
                                    <field name="count"/>
                                    <field name="evolved"/>
                                    <field name="last_date"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_warmup_player_search" model="ir.ui.view">
        <field name="name">warmup.player.search</field>
        <field name="model">warmup.player</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="archived" string="Archivés" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_warmup_player" model="ir.actions.act_window">
        <field name="name">Joueurs</field>
        <field name="res_model">warmup.player</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Crée un profil pour chaque enfant</p>
            <p>Chaque joueur a ses scores, ses records et son carnet de créatures.</p>
        </field>
    </record>
</odoo>
